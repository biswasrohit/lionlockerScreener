# Copy to .env.local for local dev. In Vercel, add each of these under
# Project Settings > Environment Variables. All three are server only.
# Never prefix them with NEXT_PUBLIC_.

# Supabase project URL, from Project Settings > API (or the Connect dialog).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret key (sb_secret_...) or the legacy service_role key.
# Project Settings > API Keys. It bypasses RLS, so keep it server side.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the team-only /results page. Use something long.
RESULTS_PASSWORD=
